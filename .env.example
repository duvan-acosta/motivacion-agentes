# === Modo de operación ===
# demo=true genera contenido de ejemplo sin llamadas a APIs externas
DEMO_MODE=false
# mock=true usa respuestas simuladas cuando faltan API keys
MOCK_MODE=true

# === OpenAI / LLM (contenido, embeddings, TTS) ===
# Soporta proveedores OpenAI-compatibles via OPENAI_BASE_URL.
# IMPORTANTE: embeddings, TTS y Whisper SOLO funcionan con OpenAI nativo;
# con DeepSeek/Groq/etc caen automáticamente al fallback.
#
# Ejemplo DeepSeek (~10× más barato, calidad alta para textos/captions):
#   OPENAI_API_KEY=sk-deepseek-xxxxx
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# === Pexels (fondos foto/video) ===
PEXELS_API_KEY=

# === ElevenLabs TTS (alternativa a OpenAI) ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_PROVIDER=openai

# === Meta / Instagram / Facebook ===
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=

# === TikTok ===
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# === YouTube ===
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# === X / Twitter ===
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# === Pinterest (API v5) ===
# No requiere media host: la imagen se sube en base64.
# Modo simple (para empezar): token estático del portal de desarrollador.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# Modo desatendido (el access token se renueva solo y no caduca):
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=

# === Auto-publicación del scheduler ===
# Plataformas que el cron diario publica tras generar (coma-separado).
# Vacío = solo genera. Ej: pinterest   |   pinterest,instagram
AUTO_PUBLISH_PLATFORMS=

# === Hosting público de media ===
# Las APIs (Meta Graph) requieren una URL pública de la imagen/video.
# Opciones: none | base_url | s3 | cloudinary
MEDIA_HOST_PROVIDER=none
# base_url: publication_queue servido estáticamente bajo esta URL
MEDIA_PUBLIC_BASE_URL=
# s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=
# cloudinary (formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=

# === Rutas ===
CHROMA_PERSIST_DIR=data/chroma
PUBLICATION_QUEUE_DIR=publication_queue
KNOWLEDGE_DIR=rag/knowledge

# === Scheduler ===
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
TIMEZONE=Europe/Madrid
