# === Modo de operación ===
# demo=true genera contenido de ejemplo sin llamadas a APIs externas
DEMO_MODE=false
# mock=true usa respuestas simuladas cuando faltan API keys
MOCK_MODE=true

# === OpenAI (contenido, embeddings, TTS) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# === Pexels (fondos foto/video) ===
PEXELS_API_KEY=

# === ElevenLabs TTS (alternativa a OpenAI) ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_PROVIDER=openai

# === Meta / Instagram / Facebook ===
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=

# === TikTok ===
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# === YouTube ===
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# === X / Twitter ===
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# === Rutas ===
CHROMA_PERSIST_DIR=data/chroma
PUBLICATION_QUEUE_DIR=publication_queue
KNOWLEDGE_DIR=rag/knowledge

# === Scheduler ===
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
TIMEZONE=Europe/Madrid
